{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arunaki",
  "version": "0.1.0",
  "identifier": "com.arunaki.desktop",
  "build": {
    "frontendDist": "../apps/dist",
    "beforeDevCommand": "npm run dev -w apps",
    "beforeBuildCommand": "npm run build -w apps"
  },
  "app": {
    "windows": [
      {
        "title": "Arunaki",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "zoomHotkeysEnabled": false,
        "browserExtensionsEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jlsrngo/Arunaki/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzRkQxNjI2Q0VBNDkyQ0UKUldUT2txVE9KaGI5RS9QdWJ5ZmZQVnJjaW5uTkhTUDFPTnFaRHpKTmRJd29NNzE3eFM1Y2JoNEMK"
    }
  }
}
