{
  "name": "arunaki",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "npm run dev:web & npm run dev:desktop",
    "dev:app": "node scripts/dev-app.cjs",
    "dev:web": "npm run dev -w apps/web",
    "dev:desktop": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -b apps/web/tsconfig.json",
    "postinstall": "bun run --cwd packages/engine/core fix-node-pty",
    "test:unit": "bun run --cwd packages/engine/engine test",
    "test:smoke": "bun run scripts/smoke-local-cli.ts",
    "verify": "npm run build && bun run tsc --noEmit -p packages/engine/engine/tsconfig.json && npm run test:unit && npm run test:smoke"
  },
  "workspaces": {
    "packages": [
      "apps/web",
      "apps/desktop",
      "packages/engine/*",
      "packages/arunaki-tools",
      "packages/arunaki-gitlab-auth",
      "packages/arunaki-poe-auth"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.83",
      "@effect/platform-node": "4.0.0-beta.83",
      "@effect/sql-sqlite-bun": "4.0.0-beta.83",
      "@lydell/node-pty": "1.2.0-beta.12",
      "@octokit/rest": "22.0.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.2.10",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "diff": "8.0.2",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.83",
      "remeda": "2.26.0",
      "solid-js": "1.9.10",
      "typescript": "5.8.2",
      "ulid": "3.0.1",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^43.2.0",
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "iterare": "^1.2.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.10.0",
    "typescript": "catalog:"
  }
}
