{
  "name": "arunaki",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "npm run dev:web & npm run dev:desktop",
    "dev:app": "node scripts/dev-app.cjs",
    "start": "node scripts/start-prod.cjs",
    "dev:web": "npm run dev -w apps/web",
    "dev:desktop": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -b apps/web/tsconfig.json",
    "test:unit": "cargo test --workspace",
    "test:smoke": "bun run scripts/smoke-local-cli.ts",
    "test:knowledge": "bun run scripts/test-knowledge-e2e.ts",
    "bundle:prepare": "node scripts/prepare-bundle.cjs",
    "verify": "npm run build && npm run test:unit && npm run test:smoke"
  },
  "workspaces": {
    "packages": [
      "apps/web",
      "apps/desktop"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^43.2.0",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "iterare": "^1.2.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.10.0",
    "typescript": "~5.8.2"
  }
}
